{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.ehis.gay/ehmodpack/schema/packages.schema.json",
  "title": "ehmodpack packages.json",
  "description": "The list of mods and resource packs a modpack is made of",
  "type": "object",
  "required": [
    "name",
    "packages"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "where an editor can find this schema"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "the schema this file was written against"
    },
    "name": {
      "type": "string",
      "description": "the modpack name, used as the .mrpack file name"
    },
    "modrinthProjectId": {
      "type": "string",
      "description": "Your modrinth project id"
    },
    "summary": {
      "type": "string",
      "description": "one line about the modpack"
    },
    "version": {
      "type": "string",
      "default": "0.0.0",
      "description": "becomes versionId in modrinth.index.json"
    },
    "top": {
      "type": "string",
      "description": "The top game version when publishing"
    },
    "client": {
      "type": "boolean",
      "default": true,
      "description": "bundle client-overrides"
    },
    "server": {
      "type": "boolean",
      "default": true,
      "description": "bundle server-overrides"
    },
    "overrides": {
      "type": "string",
      "default": "overrides",
      "description": "folder zipped into overrides/ inside the .mrpack"
    },
    "client_overrides": {
      "type": "string",
      "default": "client-overrides",
      "description": "folder zipped into client-overrides/"
    },
    "server_overrides": {
      "type": "string",
      "default": "server-overrides",
      "description": "folder zipped into server-overrides/"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "external_packs": {
      "type": "array",
      "description": "resource packs that are NOT from modrinth",
      "items": {
        "$ref": "#/$defs/external_pack"
      }
    }
  },
  "$defs": {
    "support": {
      "enum": [
        "required",
        "optional",
        "unsupported"
      ],
      "description": "required forces the file on, optional leaves it to the user, unsupported hides it"
    },
    "env": {
      "type": "object",
      "properties": {
        "client": {
          "$ref": "#/$defs/support"
        },
        "server": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "external_pack": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "file names of external resource packs"
        },
        "active": {
          "type": "boolean",
          "description": "whether it goes into the resource pack list at all"
        },
        "builtin": {
          "type": "boolean",
          "description": "built in packs from the loader you use",
          "examples": [
            true
          ]
        },
        "position": {
          "oneOf": [
            {
              "enum": [
                "top",
                "bottom"
              ]
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "description": "where it sits in the resource pack stack, 1 is the top and 2 the one under it"
        },
        "positions": {
          "type": "object",
          "description": "a position per target, as keys: minecraft+loader, minecraft, default is * and beat position",
          "additionalProperties": {
            "oneOf": [
              {
                "enum": [
                  "top",
                  "bottom"
                ]
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ]
          }
        }
      }
    },
    "package": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "mod",
            "resourcepack",
            "shader",
            "datapack"
          ],
          "description": "decides the folder the file lands in inside the .mrpack"
        },
        "project": {
          "type": "string",
          "description": "the modrinth slug, for example sodium"
        },
        "id": {
          "type": "string",
          "description": "the modrinth project id"
        },
        "version": {
          "type": "string",
          "description": "one version for every target, cannot be combined with versions"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "the embedded mod ids this project has been seen identifying as, used to confirm updates are still the same mod"
        },
        "versions": {
          "type": "object",
          "description": "a version per target, keys are tried in order: minecraft+loader, minecraft, default, *",
          "additionalProperties": {
            "type": "string"
          },
          "examples": [
            {
              "1.21.11+fabric": "0.6.0",
              "1.21.8+fabric": "0.5.3"
            }
          ]
        },
        "skip": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Skips this package from being used in this version, for all target (<gamever>) or for a loader one (<game+loader>)",
          "examples": [
            [
              "1.21.11+fabric"
            ],
            [
              "1.20.1"
            ],
            [
              "*"
            ]
          ]
        },
        "env": {
          "$ref": "#/$defs/env"
        },
        "optional": {
          "type": "boolean",
          "description": "shorthand for an optional client env"
        },
        "active": {
          "type": "boolean",
          "description": "resource packs and shaders only, which becomes active if it is when building the modpack"
        },
        "lock": {
          "type": "boolean",
          "description": "keep this package pinned at exactly this version, updates and auto-fixes leave it alone"
        },
        "position": {
          "oneOf": [
            {
              "enum": [
                "top",
                "bottom"
              ]
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "description": "where an active pack sits in the resource pack stack, 1 is the top of the stack and 2 the one under it, defaults to top"
        },
        "positions": {
          "type": "object",
          "description": "a position per target, as keys: minecraft+loader, minecraft, default is * and beat position",
          "additionalProperties": {
            "oneOf": [
              {
                "enum": [
                  "top",
                  "bottom"
                ]
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ]
          },
          "examples": [
            {
              "1.21.11+fabric": 1,
              "1.21.8+fabric": 3
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "project"
          ]
        },
        {
          "required": [
            "id"
          ]
        }
      ]
    }
  }
}
